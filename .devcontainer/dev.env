LOG_LEVEL=INFO

NEXUS_USER=value
NEXUS_PASS=value
NEXUS_HOST=host.docker.internal
NEXUS_PORT=17000
NEXUS_TRUSTSTORE=~/.m2/truststore.p12
NEXUS_TRUSTSTORE_PASS=changeIt
MAVEN_OPTS="-Djavax.net.ssl.trustStore=$NEXUS_STOREPASS -Djavax.net.ssl.trustStorePassword=changeIt -Djavax.net.ssl.trustStoreType=PKCS12"

GIT_USERNAME=value
GIT_EMAIL=value
GIT_TOKEN=value